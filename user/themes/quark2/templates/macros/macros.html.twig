{% macro nav_loop(page) %}
  {% import _self as macros %}
  {% set nav_children = page.children.visible %}
  {% if page.route == '/nieuws' %}
    {% set nav_children = page.collection({
      items: {'@self.children': ''},
      order: { by: 'header.nieuwsdatum', dir: 'desc' }
    })|slice(0, 7) %}
  {% endif %}
  {% for p in nav_children %}
    {% set active_page = (p.active or p.activeChild) ? 'active' : '' %}
    {% set has_children = p.children.visible.count > 0 %}
    <li{% if has_children %} class="has-children"{% endif %}>
      <a href="{{ p.url }}" class="{{ active_page }}">
        {% if p.header.menu_icon %}<i class="fa-solid fa-{{ p.header.menu_icon }}" aria-hidden="true"></i>{% endif %}
        {{ p.menu }}
      </a>
      {% if has_children %}
      <ul>
        {{ macros.nav_loop(p) }}
      </ul>
      {% endif %}
    </li>
  {% endfor %}
  {% if page.route == '/nieuws' and page.children.visible.count > 7 %}
    <li class="has-more">
      <a href="{{ page.url }}">Ouder nieuws &rarr;</a>
    </li>
  {% endif %}
{% endmacro %}
