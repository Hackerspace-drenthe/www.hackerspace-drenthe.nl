{% macro nav_loop(page) %}
  {% import _self as macros %}
  {% set nav_children = page.children.visible %}
  {% set show_more = false %}
  {% if page.route == '/nieuws' %}
    {% set nav_children = page.collection({
      items: {'@self.children': ''},
      order: { by: 'header.nieuwsdatum', dir: 'desc' }
    }) %}
  {% endif %}

  {% set deduped_children = [] %}
  {% set seen_urls = [] %}
  {% for p in nav_children %}
    {% set normalized_url = p.url|trim('/') %}
    {% if normalized_url not in seen_urls %}
      {% set seen_urls = seen_urls|merge([normalized_url]) %}
      {% set deduped_children = deduped_children|merge([p]) %}
    {% endif %}
  {% endfor %}
  {% set nav_children = deduped_children %}

  {% if page.route == '/nieuws' %}
    {% set show_more = nav_children|length > 7 %}
    {% set nav_children = nav_children|slice(0, 7) %}
  {% endif %}

  {% for p in nav_children %}
    {% set active_page = (p.active or p.activeChild) ? 'active' : '' %}
    {% set has_children = p.children.visible.count > 0 %}
    <li{% if has_children %} class="has-children"{% endif %}>
      <a href="{{ p.url }}" class="{{ active_page }}">
        {% if p.header.menu_icon %}<i class="fa-solid fa-{{ p.header.menu_icon }}" aria-hidden="true"></i>{% endif %}
        {{ p.menu }}
      </a>
      {% if has_children %}
      <ul>
        {{ macros.nav_loop(p) }}
      </ul>
      {% endif %}
    </li>
  {% endfor %}
  {% if page.route == '/nieuws' and show_more %}
    <li class="has-more">
      <a href="{{ page.url }}">Ouder nieuws &rarr;</a>
    </li>
  {% endif %}
{% endmacro %}
