{% extends 'partials/base.html.twig' %}

{% block content %}
    <article class="content-item">
        {% set lead_image = page.header.lead_image ? page.media.images[page.header.lead_image] : null %}
        {% if lead_image %}
            <figure class="page-lead-media">
                <img src="{{ lead_image.url }}" alt="{{ page.title|e('html_attr') }}" class="page-lead-image" loading="lazy" decoding="async" />
            </figure>
        {% endif %}

        {{ page.content|raw }}

        {% if page.slug == 'home' %}
            {% set news_page = page.find('/nieuws') %}
            {% set now_ts = 'today'|date('U') %}
            <section class="home-events-block" aria-labelledby="home-events-title">
                <h2 id="home-events-title">Aankomende geplande evenementen</h2>
                <ul class="home-events-list">
                    {% if news_page %}
                        {% set event_collection = news_page.collection({
                            items: '@self.children',
                            order: { by: 'header.nieuwsdatum', dir: 'asc' }
                        }) %}
                        {% for event_page in event_collection %}
                            {% set start_ts = event_page.header.nieuwsdatum ? event_page.header.nieuwsdatum|date('U') : null %}
                            {% set end_ts = event_page.header.nieuwsdatum_eind ? event_page.header.nieuwsdatum_eind|date('U') : null %}
                            {% if start_ts and ((end_ts and end_ts >= now_ts) or (not end_ts and start_ts >= now_ts)) %}
                                <li class="home-events-item">
                                    <a href="{{ event_page.url }}">{{ event_page.title }}</a>
                                    {% if event_page.header.nieuwsdatum_eind %}
                                        <time datetime="{{ event_page.header.nieuwsdatum|date('c') }}">{{ event_page.header.nieuwsdatum|date('d-m-Y') }} t/m {{ event_page.header.nieuwsdatum_eind|date('d-m-Y') }}</time>
                                    {% else %}
                                        <time datetime="{{ event_page.header.nieuwsdatum|date('c') }}">{{ event_page.header.nieuwsdatum|date('d-m-Y') }}</time>
                                    {% endif %}
                                </li>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </ul>
                <p class="home-events-empty">Er zijn momenteel geen aankomende evenementen gepland.</p>
            </section>
        {% endif %}
    </article>
{% endblock %}
