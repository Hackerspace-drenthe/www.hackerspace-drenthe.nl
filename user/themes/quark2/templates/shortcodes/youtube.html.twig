{% set raw = params.id|default(params.url|default(''))|trim %}
{% set video_id = raw %}

{% if 'youtube.com/embed/' in raw %}
  {% set video_id = raw|split('youtube.com/embed/')|last|split('?')|first|split('&')|first %}
{% elseif 'youtu.be/' in raw %}
  {% set video_id = raw|split('youtu.be/')|last|split('?')|first|split('&')|first %}
{% elseif 'youtube.com/watch' in raw and 'v=' in raw %}
  {% set video_id = raw|split('v=')|last|split('&')|first %}
{% endif %}

{% if video_id %}
<div class="embed-video embed-video-youtube" style="position: relative; width: 100%; max-width: 100%; padding-bottom: 56.25%; height: 0; overflow: hidden; margin: 1rem 0;">
  <iframe
    loading="lazy"
    src="https://www.youtube-nocookie.com/embed/{{ video_id|e('url') }}{% if params.start %}?start={{ params.start|e('url') }}{% endif %}"
    title="{{ params.title|default('YouTube video')|e('html_attr') }}"
    style="position: absolute; inset: 0; width: 100%; height: 100%; border: 0;"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"></iframe>
</div>
{% endif %}
